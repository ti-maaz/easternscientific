<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_eastern_invoice_sequences" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.eastern.invoice.sequences</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting string="Tax Invoice Sequence" company_dependent="1" help="Sequence used when posting customer Tax Invoices.">
                    <field name="tax_invoice_sequence_id" options="{'no_create': True}"/>
                </setting>
                <setting string="Without-Tax Invoice Sequence" company_dependent="1" help="Sequence used when posting customer invoices without tax.">
                    <field name="without_tax_invoice_sequence_id" options="{'no_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
