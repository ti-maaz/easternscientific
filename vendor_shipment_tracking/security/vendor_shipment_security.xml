<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_vendor_shipment" model="res.groups.privilege">
        <field name="name">Shipment Tracking</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_vendor_shipment_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_vendor_shipment"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>

    <record id="group_vendor_shipment_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_vendor_shipment"/>
        <field name="implied_ids" eval="[(4, ref('group_vendor_shipment_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="vendor_shipment_company_rule" model="ir.rule">
        <field name="name">Vendor shipments: multi-company</field>
        <field name="model_id" ref="model_vendor_shipment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_vendor_shipment_user'))]"/>
    </record>
</odoo>
