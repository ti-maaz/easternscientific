<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_vendor_shipment" model="ir.ui.view">
        <field name="name">purchase.order.form.vendor.shipment</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_create_vendor_shipment" string="Create Shipment" type="object"
                        groups="vendor_shipment_tracking.group_vendor_shipment_user"
                        invisible="state not in ['purchase', 'done']"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_vendor_shipments" type="object" class="oe_stat_button"
                        icon="fa-ship" groups="vendor_shipment_tracking.group_vendor_shipment_user"
                        invisible="shipment_count == 0">
                    <field name="shipment_count" widget="statinfo" string="Shipments"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
